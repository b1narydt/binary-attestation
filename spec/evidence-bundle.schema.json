{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binary.dev/bcap1/spec/evidence-bundle.schema.json",
  "title": "BCAP1 EvidenceBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "challengeId", "subject", "components"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "challengeId": { "$ref": "common.schema.json#/$defs/bytes16" },
    "subject": { "$ref": "common.schema.json#/$defs/attestationSubject" },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/component" }
    },
    "bindingEdges": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/bindingEdge" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "provider", "mediaType", "evidence"],
      "properties": {
        "componentId": { "$ref": "common.schema.json#/$defs/shortString" },
        "provider": { "$ref": "common.schema.json#/$defs/shortString" },
        "mediaType": { "$ref": "common.schema.json#/$defs/shortString" },
        "evidence": { "$ref": "#/$defs/evidenceBytes" },
        "endorsements": { "$ref": "#/$defs/endorsementBytes" },
        "untrustedMetadata": { "$ref": "common.schema.json#/$defs/stringMap" }
      }
    },
    "bindingEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parentComponentId", "childComponentId", "relation"],
      "properties": {
        "parentComponentId": { "$ref": "common.schema.json#/$defs/shortString" },
        "childComponentId": { "$ref": "common.schema.json#/$defs/shortString" },
        "relation": { "$ref": "common.schema.json#/$defs/shortString" },
        "evidence": { "$ref": "#/$defs/evidenceBytes" }
      }
    },
    "evidenceBytes": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/base64Url" },
        { "type": "string", "maxLength": 2796203 }
      ],
      "description": "At most 2 MiB after base64url decoding."
    },
    "endorsementBytes": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/base64Url" },
        { "type": "string", "maxLength": 5592406 }
      ],
      "description": "At most 4 MiB after base64url decoding."
    }
  },
  "x-bcap1-validation": ["componentId values are unique", "edges are acyclic and reference existing components", "decoded whole bundle is at most 16 MiB", "all strings are UTF-8 NFC and their UTF-8 length is at most 1,024 bytes"]
}
